# 本机 PostgreSQL 演练 / Netlify 试运行 / 正式环境统一使用
# 本机示例：
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/credit_ops_admin?schema=public"
# 云数据库示例：
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/credit_ops_admin?schema=public"

# 站点访问密码（本机演练和线上试运行都建议显式配置）
SITE_ACCESS_PASSWORD="change-me"

# AI 风控助理配置
# OpenAI:
# AI_PROVIDER="openai"
# AI_API_KEY="sk-..."
# AI_MODEL="gpt-5.2"
#
# DeepSeek:
# AI_PROVIDER="deepseek"
# AI_API_KEY="sk-..."
# AI_BASE_URL="https://api.deepseek.com"
# AI_MODEL="deepseek-v4-pro"
#
# 其他 OpenAI-compatible 供应商（Kimi / 阿里百炼 / 火山方舟 / 智谱等）：
# AI_PROVIDER="openai-compatible"
# AI_API_KEY="..."
# AI_BASE_URL="https://provider-compatible-endpoint/v1"
# AI_MODEL="provider-model-name"
