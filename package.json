{
  "name": "credit-ops-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "local:stop": "node scripts/stop-local-servers.mjs",
    "local:prepare": "node scripts/prepare-local-build.mjs",
    "local:dev": "npm run local:stop && NEXT_DIST_DIR=.next-dev npm run local:prepare && NEXT_DIST_DIR=.next-dev next dev --port 3006",
    "local:dev:stable": "npm run local:dev",
    "local:preview": "npm run local:stop && NEXT_DIST_DIR=.next-prod npm run local:prepare && NEXT_DIST_DIR=.next-prod next build && NEXT_DIST_DIR=.next-prod next start --port 3006",
    "local:stable": "npm run local:preview",
    "lint": "next lint",
    "db:check": "node scripts/check-postgres-connection.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "import:zhongcheng": "node scripts/import-zhongcheng-data.mjs",
    "import:zhongcheng:dry": "node scripts/import-zhongcheng-data.mjs --dry-run",
    "documents:rebuild-index": "node scripts/rebuild-document-index.mjs",
    "backfill:customer-codes": "node scripts/backfill-customer-codes.mjs",
    "report:customer-merge-map": "node scripts/generate-customer-merge-map.mjs",
    "migrate:customer-subjects": "node scripts/execute-customer-subject-merge.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "next": "14.2.14",
    "openai": "^6.41.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "x-data-spreadsheet": "^1.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.14",
    "playwright": "^1.58.2",
    "prisma": "^5.20.0",
    "typescript": "^5.6.3"
  }
}
