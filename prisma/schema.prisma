generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  finance
  sales
  legal
  management
}

enum CustomerStatus {
  active
  inactive
  archived
  blocked
}

enum ContractStatus {
  draft
  active
  completed
  terminated
  suspended
}

enum RiskSource {
  manual
  system
  tianyancha
  excel
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum CollectionTaskStatus {
  pending
  in_progress
  completed
  canceled
}

model User {
  id                      String               @id @default(cuid())
  username                String               @unique @db.VarChar(50)
  passwordHash            String               @map("password_hash")
  fullName                String               @map("full_name") @db.VarChar(100)
  email                   String?              @unique @db.VarChar(120)
  phone                   String?              @db.VarChar(30)
  role                    UserRole
  isActive                Boolean              @default(true) @map("is_active")
  lastLoginAt             DateTime?            @map("last_login_at")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  salesCustomers          Customer[]           @relation("CustomerSalesOwner")
  financeCustomers        Customer[]           @relation("CustomerFinanceOwner")
  legalCustomers          Customer[]           @relation("CustomerLegalOwner")
  createdCustomers        Customer[]           @relation("CustomerCreatedBy")
  createdContracts        Contract[]           @relation("ContractCreatedBy")
  createdReceivables      AccountReceivable[]  @relation("ReceivableCreatedBy")
  createdRiskRecords      RiskRecord[]         @relation("RiskCreatedBy")
  createdCreditScores     CreditScore[]        @relation("CreditScoreCreatedBy")
  assignedCollectionTasks CollectionTask[]     @relation("CollectionAssignedTo")
  createdCollectionTasks  CollectionTask[]     @relation("CollectionCreatedBy")
  monthlyReports          MonthlyReport[]      @relation("MonthlyReportCreatedBy")
  systemLogs              SystemLog[]

  @@map("users")
}

model Customer {
  id                         String              @id @default(cuid())
  customerId                 String              @unique @map("customer_id") @db.VarChar(50)
  customerCode               String?             @unique @map("customer_code") @db.VarChar(20)
  name                       String              @unique @db.VarChar(200)
  normalizedName             String?             @map("normalized_name") @db.VarChar(200)
  sourceCustomerName         String?             @map("source_customer_name") @db.VarChar(200)
  isMerged                   Boolean             @default(false) @map("is_merged")
  mergedIntoCustomerId       String?             @map("merged_into_customer_id")
  creditStatus               String?             @map("credit_status") @db.VarChar(100)
  currentStatus              String?             @map("current_status") @db.VarChar(200)
  customerNature             String?             @map("customer_nature") @db.VarChar(100)
  hasGuarantee               Boolean             @default(false) @map("has_guarantee")
  creditStanding             String?             @map("credit_standing") @db.VarChar(100)
  dueDiligenceCompleted      Boolean             @default(false) @map("due_diligence_completed")
  shortName                  String?             @map("short_name") @db.VarChar(120)
  unifiedSocialCreditCode    String?             @unique @map("unified_social_credit_code") @db.VarChar(32)
  industry                   String?             @db.VarChar(100)
  salesOwnerName             String?             @map("sales_owner_name") @db.VarChar(100)
  contactName                String?             @map("contact_name") @db.VarChar(100)
  contactPhone               String?             @map("contact_phone") @db.VarChar(30)
  contactEmail               String?             @map("contact_email") @db.VarChar(120)
  region                     String?             @db.VarChar(100)
  address                    String?
  currentCreditLevel         String?             @map("current_credit_level") @db.VarChar(20)
  creditLimit                Decimal?            @map("credit_limit") @db.Decimal(14, 2)
  stopSupply                 Boolean             @default(false) @map("stop_supply")
  remark                     String?
  riskRemark                 String?             @map("risk_remark")
  customerStatus             CustomerStatus      @default(active) @map("customer_status")
  salesOwnerId               String?             @map("sales_owner_id")
  financeOwnerId             String?             @map("finance_owner_id")
  legalOwnerId               String?             @map("legal_owner_id")
  latestCreditScore          Int?                @map("latest_credit_score")
  latestCreditScoreMonth     String?             @map("latest_credit_score_month") @db.VarChar(7)
  openclawSummary            String?             @map("openclaw_summary")
  openclawTags               Json?               @map("openclaw_tags")
  receivableSummary          Json?               @map("receivable_summary")
  riskSummary                Json?               @map("risk_summary")
  externalDataSnapshot       Json?               @map("external_data_snapshot")
  lastSyncedAt               DateTime?           @map("last_synced_at")
  createdById                String?             @map("created_by_id")
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")
  salesOwner                 User?               @relation("CustomerSalesOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  financeOwner               User?               @relation("CustomerFinanceOwner", fields: [financeOwnerId], references: [id], onDelete: SetNull)
  legalOwner                 User?               @relation("CustomerLegalOwner", fields: [legalOwnerId], references: [id], onDelete: SetNull)
  createdBy                  User?               @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  mergedIntoCustomer         Customer?           @relation("CustomerMergeHierarchy", fields: [mergedIntoCustomerId], references: [id], onDelete: SetNull)
  mergedChildCustomers       Customer[]          @relation("CustomerMergeHierarchy")
  projects                   Project[]
  ledgerProfiles             CustomerLedgerProfile[]
  contracts                  Contract[]
  accountsReceivable         AccountReceivable[]
  riskRecords                RiskRecord[]
  creditScores               CreditScore[]
  collectionTasks            CollectionTask[]
  monthlyReports             MonthlyReport[]
  systemLogs                 SystemLog[]

  mergeMappingsFrom          CustomerMergeMapping[] @relation("MergeMappingSource")
  mergeMappingsTo            CustomerMergeMapping[] @relation("MergeMappingTarget")

  @@index([name])
  @@index([normalizedName])
  @@index([isMerged])
  @@index([mergedIntoCustomerId])
  @@index([currentStatus])
  @@index([customerStatus])
  @@index([salesOwnerId])
  @@index([financeOwnerId])
  @@index([legalOwnerId])
  @@index([lastSyncedAt])
  @@map("customers")
}

model Project {
  id              String              @id @default(cuid())
  name            String              @db.VarChar(200)
  normalizedProjectName String?       @map("normalized_project_name") @db.VarChar(200)
  projectAlias    String?             @map("project_alias") @db.VarChar(200)
  projectBelonging String?            @map("project_belonging") @db.VarChar(200)
  creditStatus    String?             @map("credit_status") @db.VarChar(100)
  currentStatus   String?             @map("current_status") @db.VarChar(200)
  sourceCustomerName String?          @map("source_customer_name") @db.VarChar(200)
  derivedFromCustomerName Boolean     @default(false) @map("derived_from_customer_name")
  customerId      String              @map("customer_id")
  status          String?             @db.VarChar(100)
  remark          String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receivables     AccountReceivable[]
  riskRecords     RiskRecord[]
  ledgerProfiles  CustomerLedgerProfile[]

  @@unique([customerId, name])
  @@index([customerId])
  @@index([normalizedProjectName])
  @@map("projects")
}

model Contract {
  id                       String             @id @default(cuid())
  contractNo               String             @unique @map("contract_no") @db.VarChar(60)
  customerId               String             @map("customer_id")
  title                    String             @db.VarChar(200)
  contractBusinessId       String?            @map("contract_business_id") @db.VarChar(60)
  contractStatus           ContractStatus     @default(draft) @map("contract_status")
  currency                 String             @default("CNY") @db.VarChar(10)
  amount                   Decimal?           @db.Decimal(14, 2)
  signedAt                 DateTime?          @map("signed_at")
  billingPeriodDays        Int?               @map("billing_period_days")
  salesOwnerName           String?            @map("sales_owner_name") @db.VarChar(100)
  startDate                DateTime?          @map("start_date")
  endDate                  DateTime?          @map("end_date")
  paymentTerms             String?            @map("payment_terms")
  invoiceRequirement       String?            @map("invoice_requirement")
  remark                   String?
  summary                  String?
  openclawSummary          String?            @map("openclaw_summary")
  createdById              String?            @map("created_by_id")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  customer                 Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy                User?              @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  accountsReceivable       AccountReceivable[]

  @@index([customerId])
  @@index([contractStatus])
  @@index([signedAt])
  @@index([endDate])
  @@map("contracts")
}

model AccountReceivable {
  id                       String               @id @default(cuid())
  receivableNo             String               @unique @map("receivable_no") @db.VarChar(60)
  customerId               String               @map("customer_id")
  contractId               String?              @map("contract_id")
  projectId                String?              @map("project_id")
  projectName              String?              @map("project_name") @db.VarChar(200)
  contractReceivable       Decimal?             @map("contract_receivable") @db.Decimal(14, 2)
  cumulativeReceivable     Decimal?             @map("cumulative_receivable") @db.Decimal(14, 2)
  statementDate            DateTime?            @map("statement_date")
  businessType             String?              @map("business_type") @db.VarChar(50)
  timeNode                 String?              @map("time_node") @db.VarChar(50)
  remark                   String?
  extraFields              Json?                @map("extra_fields")
  period                   String?              @db.VarChar(20)
  paymentTerm              String?              @map("payment_term") @db.VarChar(50)
  baseDate                 DateTime?            @map("base_date")
  amount                   Decimal              @map("receivable_amount") @db.Decimal(14, 2)
  receivedAmount           Decimal?             @map("received_amount") @db.Decimal(14, 2)
  receivedDate             DateTime?            @map("received_date")
  unpaidAmount             Decimal?             @map("unpaid_amount") @db.Decimal(14, 2)
  monthlyReceivedAmount    Decimal?             @map("monthly_received_amount") @db.Decimal(14, 2)
  salesOwnerName           String?              @map("sales_owner_name") @db.VarChar(100)
  billingPeriodDays        Int?                 @map("billing_period_days")
  dueDate                  DateTime?            @map("due_date")
  isSettled                Boolean              @default(false) @map("is_settled")
  overdueDays              Int?                 @map("overdue_days")
  agingBucket              String?              @map("aging_bucket") @db.VarChar(50)
  collectionLevel          String?              @map("collection_level") @db.VarChar(50)
  riskStatus               String?              @map("risk_status") @db.VarChar(50)
  receivableStatus         String               @default("pending") @map("receivable_status") @db.VarChar(50)
  lastCollectionAt         DateTime?            @map("last_collection_at")
  expectedPaymentDate      DateTime?            @map("expected_payment_date")
  openclawSummary          String?              @map("openclaw_summary")
  receivableSnapshot       Json?                @map("receivable_snapshot")
  createdById              String?              @map("created_by_id")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  customer                 Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contract                 Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  project                  Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy                User?                @relation("ReceivableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  collectionTasks          CollectionTask[]

  @@unique([customerId, projectId])
  @@index([customerId])
  @@index([contractId])
  @@index([projectId])
  @@index([dueDate])
  @@index([overdueDays])
  @@index([agingBucket])
  @@index([collectionLevel])
  @@index([receivableStatus])
  @@map("receivables")
}

model CustomerLedgerProfile {
  id                  String              @id @default(cuid())
  customerId          String              @map("customer_id")
  projectId           String?             @map("project_id")
  sheetName           String              @map("sheet_name") @db.VarChar(100)
  workbookSource      String?             @map("workbook_source") @db.VarChar(255)
  customerName        String              @map("customer_name") @db.VarChar(200)
  projectName         String?             @map("project_name") @db.VarChar(200)
  settlementClause    String?             @map("settlement_clause")
  contractUnpaidTotal Decimal?            @map("contract_unpaid_total") @db.Decimal(14, 2)
  uninvoicedTotal     Decimal?            @map("uninvoiced_total") @db.Decimal(14, 2)
  extraSummary        Json?               @map("extra_summary")
  sheetDataJson       Json?               @map("sheet_data_json")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  rows                CustomerLedgerRow[]

  @@unique([customerId, sheetName])
  @@index([customerId])
  @@index([projectId])
  @@map("customer_ledger_profiles")
}

model CustomerLedgerRow {
  id                  String                @id @default(cuid())
  profileId           String                @map("profile_id")
  rowOrder            Int                   @map("row_order")
  statementDate       String?               @map("statement_date") @db.VarChar(50)
  quantity            Decimal?              @db.Decimal(14, 2)
  statementAmount     Decimal?              @map("statement_amount") @db.Decimal(14, 2)
  contractReceivable  Decimal?              @map("contract_receivable") @db.Decimal(14, 2)
  receivedDate        String?               @map("received_date") @db.VarChar(50)
  receivedAmount      Decimal?              @map("received_amount") @db.Decimal(14, 2)
  cumulativeReceivable Decimal?             @map("cumulative_receivable") @db.Decimal(14, 2)
  invoiceDate         String?               @map("invoice_date") @db.VarChar(50)
  invoiceQuantity     Decimal?              @map("invoice_quantity") @db.Decimal(14, 2)
  invoiceAmount       Decimal?              @map("invoice_amount") @db.Decimal(14, 2)
  remark              String?
  extraFields         Json?                 @map("extra_fields")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  profile             CustomerLedgerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([rowOrder])
  @@map("customer_ledger_rows")
}

model RiskRecord {
  id                       String             @id @default(cuid())
  customerId               String             @map("customer_id")
  projectId                String?            @map("project_id")
  riskCode                 String?            @unique @map("risk_code") @db.VarChar(60)
  riskType                 String             @map("type") @db.VarChar(100)
  riskLevel                RiskLevel          @map("level")
  source                   RiskSource         @map("source")
  title                    String             @db.VarChar(200)
  description              String?
  handled                  Boolean            @default(false)
  handlingAction           String?            @map("handling_action") @db.VarChar(200)
  followUpRecord           String?            @map("follow_up_record")
  eventAt                  DateTime?          @map("event_at")
  detectedAt               DateTime           @default(now()) @map("detected_at")
  resolvedAt               DateTime?          @map("resolved_at")
  status                   String             @default("open") @db.VarChar(50)
  sourceDetail             String?            @map("source_detail") @db.VarChar(200)
  remark                   String?
  openclawSummary          String?            @map("openclaw_summary")
  payload                  Json?
  createdById              String?            @map("created_by_id")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  customer                 Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project                  Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy                User?              @relation("RiskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([projectId])
  @@index([riskType])
  @@index([riskLevel])
  @@index([source])
  @@index([detectedAt])
  @@index([status])
  @@map("risks")
}

model ImportLog {
  id            String        @id @default(cuid())
  fileName      String        @map("file_name") @db.VarChar(255)
  importedAt    DateTime      @default(now()) @map("imported_at")
  totalCount    Int           @default(0) @map("total_count")
  successCount  Int           @default(0) @map("success_count")
  failureCount  Int           @default(0) @map("failure_count")
  errorMessage  String?       @map("error_message")
  source        String?       @db.VarChar(100)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  errors        ImportError[]

  @@index([importedAt])
  @@map("import_logs")
}

model ImportError {
  id           String    @id @default(cuid())
  importLogId  String    @map("import_log_id")
  rowRef       String?   @map("row_ref") @db.VarChar(100)
  message      String
  rawPayload   Json?     @map("raw_payload")
  createdAt    DateTime  @default(now()) @map("created_at")
  importLog    ImportLog @relation(fields: [importLogId], references: [id], onDelete: Cascade)

  @@index([importLogId])
  @@map("import_errors")
}

model CustomerMergeMapping {
  id                    String    @id @default(cuid())
  sourceCustomerId      String    @map("source_customer_id")
  targetCustomerId      String    @map("target_customer_id")
  sourceCustomerName    String    @map("source_customer_name") @db.VarChar(200)
  targetCustomerName    String    @map("target_customer_name") @db.VarChar(200)
  projectAlias          String?   @map("project_alias") @db.VarChar(200)
  splitKind             String?   @map("split_kind") @db.VarChar(50)
  suggestedAction       String?   @map("suggested_action") @db.VarChar(100)
  originalSourceName    String?   @map("original_source_name") @db.VarChar(200)
  status                String    @default("applied") @db.VarChar(50)
  notes                 String?
  appliedAt             DateTime  @default(now()) @map("applied_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  sourceCustomer        Customer  @relation("MergeMappingSource", fields: [sourceCustomerId], references: [id], onDelete: Cascade)
  targetCustomer        Customer  @relation("MergeMappingTarget", fields: [targetCustomerId], references: [id], onDelete: Cascade)

  @@unique([sourceCustomerId])
  @@index([targetCustomerId])
  @@index([status])
  @@map("customer_merge_mappings")
}

model CreditScore {
  id                       String             @id @default(cuid())
  customerId               String             @map("customer_id")
  scoreMonth               String             @map("score_month") @db.VarChar(7)
  creditRiskScore          Int                @default(0) @map("credit_risk_score")
  businessRiskScore        Int                @default(0) @map("business_risk_score")
  financialRiskScore       Int                @default(0) @map("financial_risk_score")
  score                    Int
  scoreLevel               String?            @map("score_level") @db.VarChar(50)
  riskAction               String?            @map("risk_action") @db.VarChar(50)
  riskStatus               String?            @map("risk_status") @db.VarChar(50)
  scoreDelta               Int?               @map("score_delta")
  scoreVersion             String?            @map("score_version") @db.VarChar(50)
  scoreReason              String?            @map("score_reason")
  keyAttention             Boolean            @default(false) @map("key_attention")
  riskFlags                Json?              @map("risk_flags")
  openclawSummary          String?            @map("openclaw_summary")
  createdById              String?            @map("created_by_id")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  customer                 Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy                User?              @relation("CreditScoreCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([customerId, scoreMonth])
  @@index([scoreMonth])
  @@index([score])
  @@map("credit_scores")
}

model CollectionTask {
  id                       String               @id @default(cuid())
  taskNo                   String               @unique @map("task_no") @db.VarChar(60)
  customerId               String               @map("customer_id")
  receivableId             String?              @map("receivable_id")
  assignedToId             String?              @map("assigned_to_id")
  title                    String               @db.VarChar(200)
  collectionLevel          String?              @map("collection_level") @db.VarChar(50)
  priority                 String?              @db.VarChar(50)
  dueDate                  DateTime?            @map("due_date")
  taskStatus               CollectionTaskStatus @default(pending) @map("task_status")
  handoffToLegal           Boolean              @default(false) @map("handoff_to_legal")
  resultSummary            String?              @map("result_summary")
  nextAction               String?              @map("next_action")
  currentMeasure           String?              @map("current_measure")
  openclawSummary          String?              @map("openclaw_summary")
  createdById              String?              @map("created_by_id")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  customer                 Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  receivable               AccountReceivable?   @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  assignedTo               User?                @relation("CollectionAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy                User?                @relation("CollectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([receivableId])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([collectionLevel])
  @@index([taskStatus])
  @@map("collection_tasks")
}

model MonthlyReport {
  id                       String      @id @default(cuid())
  reportMonth              String      @map("report_month") @db.VarChar(7)
  customerId               String?     @map("customer_id")
  title                    String      @db.VarChar(200)
  reportType               String?     @map("report_type") @db.VarChar(50)
  overview                 String?
  metricsSnapshot          Json?       @map("metrics_snapshot")
  openclawSummary          String?     @map("openclaw_summary")
  createdById              String?     @map("created_by_id")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")
  customer                 Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy                User?       @relation("MonthlyReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([reportMonth])
  @@index([customerId])
  @@map("monthly_reports")
}

model SystemLog {
  id                       String      @id @default(cuid())
  userId                   String?     @map("user_id")
  customerId               String?     @map("customer_id")
  module                   String      @db.VarChar(60)
  action                   String      @db.VarChar(100)
  targetType               String?     @map("target_type") @db.VarChar(60)
  targetId                 String?     @map("target_id") @db.VarChar(100)
  message                  String?
  detail                   Json?
  ipAddress                String?     @map("ip_address") @db.VarChar(64)
  userAgent                String?     @map("user_agent")
  createdAt                DateTime    @default(now()) @map("created_at")
  user                     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer                 Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerId])
  @@index([module])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("system_logs")
}
